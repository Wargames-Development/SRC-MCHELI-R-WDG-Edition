diff --git a/src/main/java/mcheli/weapon/MCH_GPSPosition.java b/src/main/java/mcheli/weapon/MCH_GPSPosition.java
index 00d96f2..545176e 100644
--- a/src/main/java/mcheli/weapon/MCH_GPSPosition.java
+++ b/src/main/java/mcheli/weapon/MCH_GPSPosition.java
@@ -8,13 +8,22 @@ import net.minecraft.entity.Entity;
 
 import java.util.HashMap;
 import java.util.Map;
+import java.util.WeakHashMap;
 
 public class MCH_GPSPosition {
 
+    // Five server ticks at 20 TPS, matching the 0.25-second client interval.
+    public static final long MIN_SET_INTERVAL_TICKS = 5L;
+    private static final long MIN_SET_INTERVAL_NANOS = 250000000L;
+
     public static Map<Integer, MCH_GPSPosition> currentGPSPositions = new HashMap<>();
 
     public static MCH_GPSPosition currentClientGPSPosition = new MCH_GPSPosition(0, 0, 0);
 
+    private static final Map<Entity, Long> lastServerSetTicks = new WeakHashMap<Entity, Long>();
+    private static int lastClientSetOwnerId = Integer.MIN_VALUE;
+    private static long lastClientSetNanos = Long.MIN_VALUE;
+
     public double x, y, z;
     public Entity owner;
     public boolean isActive = false;
@@ -27,11 +36,48 @@ public class MCH_GPSPosition {
 
     public static void set(double x, double y, double z, boolean isActive, Entity owner) {
         if (owner != null && owner.worldObj != null && owner.worldObj.isRemote) {
+            if (isActive && !canSetClientPosition(owner)) {
+                return;
+            }
+            if (isActive) {
+                markClientPositionSet(owner);
+            }
             clientSet(x, y, z, isActive, owner);
             MCH_MOD.getPacketHandler().sendToServer(new PacketGPSPositionReset(x, y, z, isActive, owner.getEntityId()));
         }
     }
 
+    public static boolean canSetClientPosition(Entity owner) {
+        if (owner == null || owner.worldObj == null || !owner.worldObj.isRemote) {
+            return false;
+        }
+        int ownerId = owner.getEntityId();
+        if (ownerId != lastClientSetOwnerId) {
+            return true;
+        }
+        return System.nanoTime() - lastClientSetNanos >= MIN_SET_INTERVAL_NANOS;
+    }
+
+    private static void markClientPositionSet(Entity owner) {
+        lastClientSetOwnerId = owner.getEntityId();
+        lastClientSetNanos = System.nanoTime();
+    }
+
+    public static boolean tryBeginServerPositionSet(Entity owner, long currentTick) {
+        if (owner == null || owner.worldObj == null || owner.worldObj.isRemote) {
+            return false;
+        }
+        synchronized (lastServerSetTicks) {
+            Long lastTick = lastServerSetTicks.get(owner);
+            if (lastTick != null && currentTick >= lastTick
+                && currentTick - lastTick < MIN_SET_INTERVAL_TICKS) {
+                return false;
+            }
+            lastServerSetTicks.put(owner, currentTick);
+            return true;
+        }
+    }
+
     public static MCH_GPSPosition get(Entity owner) {
         return owner != null ? currentGPSPositions.get(owner.getEntityId()) : null;
     }
